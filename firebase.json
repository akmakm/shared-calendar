{
  "hosting": {
    "public": "public", 
    "rewrites": [
      {
        "source": "/api/askfaq**",
        "function": "askFaq",
        "region": "us-central1"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      // ],
      // "predeploy": [
      //   "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ]
}
